{
  "functions": {
    "api/panel/notes/distribute.js": { "maxDuration": 30 },
    "api/panel/ai-cron.js": { "maxDuration": 60 },
    "api/panel/subject-cron.js": { "maxDuration": 60 },
    "api/panel/openai-cron.js": { "maxDuration": 60 },
    "api/panel/manheim-audit.js": { "maxDuration": 60 },
    "api/panel/manheim-batch.js": { "maxDuration": 30 },
    "api/panel/manheim-options.js": { "maxDuration": 30 },
    "api/panel/triage.js": { "maxDuration": 60 },
    "api/panel/unlock-sale.js": { "maxDuration": 60 },
    "api/panel/purge-tests.js": { "maxDuration": 60 },
    "api/panel/ai-conversations.js": { "maxDuration": 30 },
    "api/panel/reply.js": { "maxDuration": 30 },
    "api/panel/v1-send.js": { "maxDuration": 30 },
    "api/panel/assistant.js": { "maxDuration": 60 },
    "api/panel/pesquisas.js": { "maxDuration": 60 },
    "api/panel/client-context.js": { "maxDuration": 30 },
    "api/panel/suggestions.js": { "maxDuration": 45 },
    "api/panel/history-import.js": { "maxDuration": 60 },
    "api/panel/media-cron.js": { "maxDuration": 60 },
    "api/whatsapp/webhook.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/panel/ai-cron", "schedule": "*/10 * * * *" },
    { "path": "/api/panel/subject-cron", "schedule": "3-59/5 * * * *" },
    { "path": "/api/panel/openai-cron", "schedule": "2-59/5 * * * *" },
    { "path": "/api/panel/media-cron", "schedule": "* * * * *" }
  ],
  "headers": [
    { "source": "/painel", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store, max-age=0" }
    ] },
    { "source": "/painel/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store, max-age=0" }
    ] },
    { "source": "/api/panel/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store, max-age=0" }
    ] },
    { "source": "/api/whatsapp/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store, max-age=0" }
    ] },
    { "source": "/t/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store, max-age=0" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
    ,{ "source": "/o/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store, max-age=0" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
    ,{ "source": "/v/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store, max-age=0" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ],
  "redirects": [
    { "source": "/:path([Pp][Aa][Ii][Nn][Ee][Ll])", "destination": "/painel/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/panel/(.*)", "destination": "/api/panel/$1" },
    { "source": "/api/whatsapp/(.*)", "destination": "/api/whatsapp/$1" },
    { "source": "/t/:code([A-Za-z0-9_-]{22,80})", "destination": "/t/index.html" },
    { "source": "/v/:token([A-Za-z0-9_-]{32,80})", "destination": "/v/index.html" },
    { "source": "/o/:code([A-Za-z0-9_-]{32,80})", "destination": "/o/index.html" },
    { "source": "/painel", "destination": "/painel/index.html" },
    { "source": "/painel/(.*)", "destination": "/painel/$1" },
    { "source": "/(.*)", "destination": "/msc-calculadora.html" }
  ]
}
